{
  "appId": "com.halleylab.rhinelab",
  "appName": "Rhine Lab",
  "webDir": "www",
  "backgroundColor": "#eef5d3",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "backgroundColor": "#eef5d3"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#eef5d3"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 180,
      "backgroundColor": "#eef5d3",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "backgroundColor": "#00000000",
      "style": "DARK"
    }
  }
}
