{
  "name": "rhine-lab",
  "version": "0.2.4",
  "private": true,
  "description": "Rhine Lab life-science workspace for web, mobile and desktop",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "mobile:assets": "node scripts/create-mobile-assets.mjs",
    "mobile:icons": "pnpm exec capacitor-assets generate --android && node scripts/sync-android-icons.mjs && node scripts/verify-icons.mjs",
    "mobile:sync": "pnpm mobile:prepare && pnpm mobile:assets && cap sync android && pnpm mobile:icons",
    "android:debug": "pnpm mobile:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "pnpm mobile:sync && cd android && gradlew.bat assembleRelease",
    "android:bundle": "pnpm mobile:sync && cd android && gradlew.bat bundleRelease",
    "android:collect": "node scripts/collect-android-release.mjs",
    "android:package": "pnpm android:release && pnpm android:collect",
    "release:clean": "node scripts/clean-release.mjs",
    "release:finalize": "node scripts/finalize-release.mjs",
    "release:local": "pnpm release:clean && pnpm desktop:build && pnpm android:release && pnpm android:collect && pnpm release:finalize",
    "desktop:start": "electron .",
    "desktop:assets": "node scripts/create-desktop-assets.mjs",
    "desktop:build": "pnpm desktop:assets && electron-builder --win nsis --publish never",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.toml",
    "cloudflare:db:local": "wrangler d1 execute rhine-lab --local --config cloudflare/wrangler.toml --file cloudflare/schema.sql",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "morphicons": "1.7.1",
    "sharp": "0.35.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.halleylab.rhinelab.desktop",
    "productName": "Rhine Lab",
    "artifactName": "Rhine-Lab-${version}-Windows-Setup.${ext}",
    "directories": {
      "output": "dist/release-${version}"
    },
    "files": [
      "index.html",
      "app.webmanifest",
      "css/**/*",
      "data/**/*",
      "images/**/*",
      "js/**/*",
      "desktop/**/*"
    ],
    "win": {
      "icon": "images/rhine-lab-desktop-icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HalleyLab",
        "repo": "Rhine_Lab",
        "releaseType": "release"
      }
    ]
  }
}
